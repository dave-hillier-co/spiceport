<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Persistence.Memory" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Reuse the conformance YAML loader (it lives in the sibling test project and is not
       referenceable as a package), by linking its source files in here. -->
  <ItemGroup>
    <Compile Include="..\Spiceport.Conformance.Tests\Loading\ValidationFileLoader.cs" Link="Loading\ValidationFileLoader.cs" />
    <Compile Include="..\Spiceport.Conformance.Tests\Loading\ValidationModel.cs" Link="Loading\ValidationModel.cs" />
  </ItemGroup>

  <!-- Link the FULL conformance corpus as content (copied to output), so the grain-mesh tests can run
       both the representative subset (ConformanceMeshTests) AND the entire corpus through the mesh with
       the exact visited set (FullCorpusMeshVisitedSetTests, the mandatory visited-set-correctness gate). -->
  <ItemGroup>
    <None Include="..\Spiceport.Conformance.Tests\TestData\*.yaml" Link="TestData\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Vendored Orleans AdoNet Postgres persistence schema (v10.1.0), applied by the durability test's
       Testcontainers fixture before a silo uses AdoNet grain storage. The 10.1.0 nupkg ships no SQL. -->
  <ItemGroup>
    <None Include="Durability\OrleansSql\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spiceport.Datastore\Spiceport.Datastore.csproj" />
    <ProjectReference Include="..\..\src\Spiceport.Core\Spiceport.Core.csproj" />
    <ProjectReference Include="..\..\src\Spiceport.Protos\Spiceport.Protos.csproj" />
    <ProjectReference Include="..\..\src\Spiceport.Api\Spiceport.Api.csproj" />
    <ProjectReference Include="..\..\src\Spiceport.Server\Spiceport.Server.csproj" />
  </ItemGroup>

</Project>